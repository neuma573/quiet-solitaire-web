{
  // LOCAL DEVELOPMENT ONLY. No remote database ID or routes are configured.
  "name": "quiet-solitaire-leaderboard-local",
  "main": "index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:8787",
    "API_PREFIX": "",
    "LOCAL_DEVELOPMENT": "true",
    "RATE_LIMIT_SALT": "LOCAL-ONLY-public-test-salt-replace-in-production"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "leaderboard",
    "database_id": "00000000-0000-4000-8000-000000000000",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": false }
}
